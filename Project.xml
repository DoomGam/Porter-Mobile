<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="Porter-Mobile" package="com.doomgam.portermobile" version="1.0.0" company="DoomGam" />
	
	<app main="Main" file="PorterMobile" path="export" />
	
	<window width="1280" height="720" fps="60" background="#121212" hardware="true" vsync="true" />
	<window orientation="landscape" resizable="true" fullscreen="false" />

	<source path="source" />
	
	<assets path="assets/images" rename="images" embed="true" />
	<assets path="assets/sounds" rename="sounds" embed="true" />
	<assets path="assets/fonts" type="font" rename="fonts" embed="true" />

	<haxelib name="openfl" />
	<haxelib name="flixel" />
	<haxelib name="flixel-ui" />
	<haxelib name="hscript" />
	<haxelib name="extension-androidtools" if="android" />

	<config :android permission="android.permission.READ_EXTERNAL_STORAGE" />
	<config :android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
	<config :android permission="android.permission.INTERNET" />

	<architecture name="arm64" if="android" />
	<architecture name="armv7" if="android" />

	<haxeflag name="-dce full" />
</project>
